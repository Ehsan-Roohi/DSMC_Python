#!/usr/bin/env bash
#SBATCH --job-name=moh-mv17b-a1-post
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=16G
#SBATCH --time=03:00:00

set -euo pipefail
: "${MV17B_PROJECT_ROOT:?}"
: "${MV17B_OUTPUT_ROOT:?}"
: "${MV17B_PYTHON:?}"
: "${MV17B_A1_SUBMISSION_ENV:?}"
CAMPAIGN="${MV17B_OUTPUT_ROOT}/campaign"
test -s "${MV17B_OUTPUT_ROOT}/analysis/summary.json"
exec > >(tee "${CAMPAIGN}/logs/post_a1_${SLURM_JOB_ID}.out") 2>&1
cd "${MV17B_PROJECT_ROOT}"
export PATH="$(dirname "${MV17B_PYTHON}"):${PATH}"
export PYTHONPATH="${MV17B_PROJECT_ROOT}:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
source "${MV17B_A1_SUBMISSION_ENV}"
sacct -j "${MV17B_A1_ALL_JOB_IDS}" -X -P \
  --format=JobID,JobIDRaw,JobName,State,ExitCode,ElapsedRaw,CPUTimeRAW,MaxRSS,NodeList \
  > "${MV17B_OUTPUT_ROOT}/analysis/mv17b_slurm_accounting.psv" || true
"${MV17B_PYTHON}" -m vgdsmc.mohammadzadeh_mv17b_fresh_cylinder_confirmation package \
  --output-root "${MV17B_OUTPUT_ROOT}" \
  --return-directory "${MV17B_PROJECT_ROOT}"
test -s "${MV17B_PROJECT_ROOT}/LAST_MOHAMMADZADEH_MV17B_FRESH_CYLINDER_RESULT.env"
source "${MV17B_PROJECT_ROOT}/LAST_MOHAMMADZADEH_MV17B_FRESH_CYLINDER_RESULT.env"
"${MV17B_PYTHON}" -m vgdsmc.mohammadzadeh_mv17b_a1_mechanical_recovery augment-package \
  --output-root "${MV17B_OUTPUT_ROOT}" \
  --archive "${MV17B_RESULT_ARCHIVE}"
MV17B_RESULT_ARCHIVE_SHA256=$(sha256sum "${MV17B_RESULT_ARCHIVE}" | awk '{print $1}')
cat > "${MV17B_PROJECT_ROOT}/LAST_MOHAMMADZADEH_MV17B_FRESH_CYLINDER_RESULT.env.tmp" <<EOF
MV17B_OUTPUT_ROOT=${MV17B_OUTPUT_ROOT}
MV17B_RESULT_ARCHIVE=${MV17B_RESULT_ARCHIVE}
MV17B_RESULT_ARCHIVE_SHA256=${MV17B_RESULT_ARCHIVE_SHA256}
MV17B_DECISION=$(jq -r '.decision' "${MV17B_OUTPUT_ROOT}/analysis/summary.json")
MV17B_FRESH_DSMC_TRAJECTORIES=12
MV17B_NEURAL_TRAINING=false
MV17B_FRESH_PARAMETER_SELECTION=false
MV17B_A1_MECHANICAL_RECOVERY=true
EOF
mv "${MV17B_PROJECT_ROOT}/LAST_MOHAMMADZADEH_MV17B_FRESH_CYLINDER_RESULT.env.tmp" \
  "${MV17B_PROJECT_ROOT}/LAST_MOHAMMADZADEH_MV17B_FRESH_CYLINDER_RESULT.env"
cp -a "${MV17B_PROJECT_ROOT}/LAST_MOHAMMADZADEH_MV17B_FRESH_CYLINDER_RESULT.env" \
  "${MV17B_PROJECT_ROOT}/LAST_MOHAMMADZADEH_MV17B_A1_MECHANICAL_RECOVERY_RESULT.env.tmp"
cat >> "${MV17B_PROJECT_ROOT}/LAST_MOHAMMADZADEH_MV17B_A1_MECHANICAL_RECOVERY_RESULT.env.tmp" <<EOF
MV17B_A1_RECOVERY_TRAJECTORIES=7
MV17B_A1_COMPLETE_TRAJECTORIES_REUSED=5
MV17B_A1_SEEDS_REPLACED=0
MV17B_A1_SCIENTIFIC_CONTRACT_CHANGED=false
EOF
mv "${MV17B_PROJECT_ROOT}/LAST_MOHAMMADZADEH_MV17B_A1_MECHANICAL_RECOVERY_RESULT.env.tmp" \
  "${MV17B_PROJECT_ROOT}/LAST_MOHAMMADZADEH_MV17B_A1_MECHANICAL_RECOVERY_RESULT.env"
echo "MV17B_A1_POST_PASS output=${MV17B_OUTPUT_ROOT}"
