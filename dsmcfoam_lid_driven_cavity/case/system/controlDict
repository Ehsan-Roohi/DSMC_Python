FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application         dsmcFoam;
startFrom           startTime;
startTime           0;
stopAt              endTime;
endTime             1e-7;
deltaT              5e-12;
writeControl        timeStep;
writeInterval       2000;
purgeWrite          0;
writeFormat         ascii;
writePrecision      10;
writeCompression    off;
timeFormat          scientific;
timePrecision       10;
runTimeModifiable   false;
adjustTimeStep      no;

functions
{
    fieldAverage1
    {
        type            fieldAverage;
        libs            (fieldFunctionObjects);
        timeStart       2e-8;
        writeControl    writeTime;
        fields
        (
            rhoN
            {
                mean        yes;
                prime2Mean  no;
                base        time;
            }
            rhoM
            {
                mean        yes;
                prime2Mean  no;
                base        time;
            }
            dsmcRhoN
            {
                mean        yes;
                prime2Mean  no;
                base        time;
            }
            momentum
            {
                mean        yes;
                prime2Mean  no;
                base        time;
            }
            linearKE
            {
                mean        yes;
                prime2Mean  no;
                base        time;
            }
            internalE
            {
                mean        yes;
                prime2Mean  no;
                base        time;
            }
            iDof
            {
                mean        yes;
                prime2Mean  no;
                base        time;
            }
            q
            {
                mean        yes;
                prime2Mean  no;
                base        time;
            }
            fD
            {
                mean        yes;
                prime2Mean  no;
                base        time;
            }
        );
    }

    dsmcFields1
    {
        type            dsmcFields;
        libs            ("liblagrangianFunctionObjects.so");
        writeControl    writeTime;
    }
}
