boundaryField
{
    fixedWalls
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    movingWall
    {
        type            fixedValue;
        value           uniform (100 0 0);
    }
    front { type cyclic; }
    back  { type cyclic; }
}
